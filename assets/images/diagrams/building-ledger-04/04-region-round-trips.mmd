---
config:
  theme: base
  look: handDrawn
  themeVariables:
    fontFamily: Pretendard
    primaryColor: '#E8F7FB'
    primaryTextColor: '#062E61'
    primaryBorderColor: '#59BDD8'
    lineColor: '#5F7082'
    secondaryColor: '#FFF3E8'
    tertiaryColor: '#F7FBFC'
---
flowchart TB
    subgraph BEFORE["이전 · 사용자 인접 서버와 원격 저장소"]
        direction LR
        U1["사용자"] --> K1["사용자 인접 BFF"]
        K1 --> K2["사용자 인접 JVM"]
        K1 == "요청마다 여러 차례<br/>장거리 왕복" ==> D1[("원격 데이터 저장소")]
        K2 == "반복되는 장거리 왕복" ==> D1
    end

    subgraph AFTER["변경 · 계산을 데이터 가까이"]
        direction LR
        U2["사용자"] == "장거리 구간은<br/>요청당 한 번" ==> B2["데이터 인접 BFF"]
        B2 --> J2["데이터 인접 JVM"]
        B2 -->|"짧은 내부 왕복"| D2[("데이터 저장소")]
        J2 -->|"짧은 내부 왕복"| D2
    end

    BEFORE -->|"측정 후 전제 수정"| AFTER

    classDef user fill:#F7FBFC,stroke:#5F7082,color:#172536,stroke-width:2px;
    classDef server fill:#E8F7FB,stroke:#59BDD8,color:#062E61,stroke-width:2px;
    classDef data fill:#062E61,stroke:#031F43,color:#FFFFFF,stroke-width:2px;
    class U1,U2 user;
    class K1,K2,B2,J2 server;
    class D1,D2 data;
