{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mysc-native-editor",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "GITHUB_OWNER": "merryAI-dev",
    "GITHUB_REPO": "merryAI-dev.github.io",
    "GITHUB_BRANCH": "main",
    "POST_AUTHOR": "MYSC AX팀"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
